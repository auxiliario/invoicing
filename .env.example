# ── Google OAuth (https://console.cloud.google.com/apis/credentials) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── NextAuth ──
NEXTAUTH_SECRET=generate-a-random-string-here
NEXTAUTH_URL=http://localhost:3000

# ── Admin email(s), comma-separated ──
ADMIN_EMAILS=maxwellmaciver@gmail.com

# ── Vercel Postgres (auto-populated when you link a DB in Vercel dashboard) ──
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ── Vercel Blob (auto-populated when you add Blob store in Vercel dashboard) ──
BLOB_READ_WRITE_TOKEN=
